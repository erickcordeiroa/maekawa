// Campos "enum" são String validados pelo domínio (src/domain).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  approvals    Student[] @relation("StudentApprovedBy")
}

model Plan {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String
  priceCents  Int // valor mensal
  isKids      Boolean   @default(false) // matrícula entra na turma Kids
  active      Boolean   @default(true) // inativo: some do cadastro público, alunos atuais continuam
  position    Int       @default(0)
  students    Student[]
}

model ClassGroup {
  id          Int          @id @default(autoincrement())
  slug        String       @unique // manha | kids | noite
  name        String
  startTime   String // "19:00"
  position    Int          @default(0)
  students    Student[]
  attendances Attendance[]
}

model Student {
  id            Int              @id @default(autoincrement())
  fullName      String
  shortName     String
  phone         String? // apenas dígitos; opcional para menor. Pode se repetir na família (filhos com o telefone do pai)
  cpf           String?          @unique @db.Char(11) // apenas dígitos; obrigatório para adultos
  birthDate     DateTime
  address       String           @db.VarChar(500)
  guardianName  String?
  guardianPhone String?
  guardianCpf   String?          @db.Char(11)
  belt          String // branca | cinza | ... | preta
  stripes       Int              @default(0)
  isKids        Boolean          @default(false)
  status        String           @default("ativo") // ativo | pendente | inativo (desativado, nunca excluído)
  dueDay        Int              @default(5)
  memberSince   DateTime         @default(now())
  approvedAt    DateTime? // matrícula confirmada pela academia
  approvedById  Int?
  approvedBy    User?            @relation("StudentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  planId        Int
  plan          Plan             @relation(fields: [planId], references: [id])
  classGroupId  Int?
  classGroup    ClassGroup?      @relation(fields: [classGroupId], references: [id])
  graduations   Graduation[]
  payments      Payment[]
  attendances   Attendance[]
  terms         TermAcceptance[]
  createdAt     DateTime         @default(now())

  @@index([belt])
  @@index([phone])
  @@index([guardianPhone])
  @@index([fullName, birthDate])
}

// Registro do aceite do Termo de Responsabilidade (substitui a assinatura em papel)
model TermAcceptance {
  id         Int      @id @default(autoincrement())
  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  version    String // TERM_VERSION em src/domain/term.ts
  signerRole String // aluno | responsavel
  signerName String
  signerCpf  String   @db.Char(11)
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(500)
  acceptedAt DateTime @default(now())

  @@index([studentId, acceptedAt])
}

model Graduation {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind      String // inicio | grau | promocao
  belt      String
  stripes   Int
  date      DateTime
  createdAt DateTime @default(now())

  @@index([studentId, date])
}

model Payment {
  id          Int       @id @default(autoincrement())
  studentId   Int
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reference   String // "2026-11"
  amountCents Int
  dueDate     DateTime
  paidAt      DateTime?
  transaction Transaction? // entrada no Financeiro criada ao registrar o pagamento

  @@unique([studentId, reference])
  @@index([reference])
}

model Attendance {
  id           Int        @id @default(autoincrement())
  studentId    Int
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroupId Int
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  date         DateTime // dia da aula (00:00 local)
  present      Boolean
  source       String     @default("manual") // manual | qr
  checkedInAt  DateTime?

  @@unique([studentId, classGroupId, date])
  @@index([date])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  date        DateTime
  description String   @db.VarChar(500)
  kind        String // entrada | saida
  category    String
  amountCents Int // sempre positivo; o sinal vem de `kind`
  paymentId   Int?     @unique // preenchido quando a entrada vem de uma mensalidade paga
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([date])
}
